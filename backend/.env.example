# MongoDB connection string (local default shown)
MONGO_URI=mongodb://127.0.0.1:27017/IBookingdb
# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
# Port and bind address (use HOST=0.0.0.0 only on a host such as Render)
PORT=5000
HOST=127.0.0.1
# Allowed browser origins, comma separated
CORS_ORIGIN=http://localhost:3000
# Optional: `npm run seed` creates this admin user when both are set
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Optional rate limit ceilings
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
